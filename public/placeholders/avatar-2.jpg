<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e"/>
      <stop offset="100%" style="stop-color:#0a0a0f"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00d4ff;stop-opacity:0.3"/>
      <stop offset="100%" style="stop-color:#7c3aed;stop-opacity:0.3"/>
    </linearGradient>
    <clipPath id="circle">
      <circle cx="200" cy="200" r="180"/>
    </clipPath>
  </defs>

  <!-- Background circle -->
  <circle cx="200" cy="200" r="190" fill="url(#bg)" stroke="url(#accent)" stroke-width="4"/>

  <!-- Avatar placeholder -->
  <g clip-path="url(#circle)">
    <rect width="100%" height="100%" fill="url(#bg)"/>

    <!-- Head -->
    <circle cx="200" cy="150" r="70" fill="rgba(255,255,255,0.1)"/>

    <!-- Body -->
    <ellipse cx="200" cy="350" rx="100" ry="80" fill="rgba(255,255,255,0.08)"/>
  </g>

  <!-- Outer glow -->
  <circle cx="200" cy="200" r="190" fill="none" stroke="rgba(0,212,255,0.1)" stroke-width="2"/>
</svg>
